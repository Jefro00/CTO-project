# AUTOMOTIVE OS Configuration (Section 102)

# Environment
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database (PostgreSQL / SQLite fallback for lightweight development)
DATABASE_URL="file:./dev.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/automotive_os?schema=public"

# Redis & Queue
REDIS_URL=redis://localhost:6379

# JWT Secrets
JWT_SECRET=super-secret-jwt-key-for-automotive-os-2026
JWT_REFRESH_SECRET=super-secret-jwt-refresh-key-for-automotive-os-2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# S3 / MinIO Object Storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=automotive-os
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_USE_SSL=false

# SMTP / Email (Post-MVP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@automotive-os.local
SMTP_PASSWORD=secret

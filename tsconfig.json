{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@automotive-os/types": ["packages/types/src"],
      "@automotive-os/permissions": ["packages/permissions/src"],
      "@automotive-os/config": ["packages/config/src"],
      "@automotive-os/api-client": ["packages/api-client/src"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", "apps/web", "apps/mobile", "tests", "playwright.config.ts"]
}
